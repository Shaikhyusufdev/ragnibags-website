# --- Admin login ---
# Yeh password se hi tum /admin panel me login karoge
ADMIN_PASSWORD=change-this-password

# --- GitHub (products data + images seedha repo me commit karne ke liye) ---
# GitHub -> Settings -> Developer settings -> Fine-grained tokens
# Repo access: sirf ye repo, Permission: Contents = Read and write
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=your-github-username
GITHUB_REPO=ragnibags-website
GITHUB_BRANCH=main
